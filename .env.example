# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. `.env` is git-ignored on purpose:
# never commit real credentials.
#
#   cp .env.example .env
#
# How these values are used:
#
#   1. Docker Compose
#      `docker compose` reads `.env` automatically from the project root and
#      substitutes DB_USER / DB_PASSWORD / DB_NAME / DB_PORT into
#      docker-compose.yml to configure and publish the PostgreSQL container.
#
#   2. The Nest app, running on your machine
#      @nestjs/config loads `.env` from the project root automatically, so
#      `npm run start:dev` connects to the containerised database with these
#      same values.
#
# Docker hosts the database only, which is why DB_HOST is `localhost`: the app
# connects to the published port on your own machine, not over a compose
# network.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Port the Nest app binds to. Nothing in Docker publishes it any more.
PORT=3000

# --- PostgreSQL credentials -------------------------------------------------
# The same three values are used twice and must agree:
#   - Compose maps them onto the Postgres image's POSTGRES_* bootstrap variables.
#   - The app passes them to TypeORM as the credentials it connects with.
#
# DEV ONLY: `postgres`/`postgres` is a throwaway local password. It is fine
# for a database that is only reachable from your own machine. Do not reuse it
# anywhere else.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task

# --- Database host ----------------------------------------------------------
# `localhost` because the app runs on your machine. This was the Compose
# service name `db` back when the app was containerised too; inside a container
# `localhost` would have pointed at the app container itself, but from the host
# it correctly points at the published Postgres port.
DB_HOST=localhost

# Port the app connects to, i.e. the HOST side of the "DB_PORT:5432" mapping in
# docker-compose.yml. It defaults to 5433 because a local PostgreSQL install
# usually owns 5432 and the bind would then fail with "port is already
# allocated". Postgres always listens on 5432 *inside* the container; only this
# host-side port is configurable.
#
# Change it and it changes in both places at once, because Compose reads it
# from this same file.
DB_PORT=5433

# --- Schema management ------------------------------------------------------
# `true` lets TypeORM create/alter tables from the entities on boot. Convenient
# locally, but it can destroy data on a real database. Set to `false` and use
# migrations if this ever points at anything you care about.
DB_SYNC=true