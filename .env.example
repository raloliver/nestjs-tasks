# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. `.env` is git-ignored on purpose:
# never commit real credentials.
#
#   cp .env.example .env
#
# The two supported ways to supply these values:
#
#   1. Docker Compose (recommended for local dev)
#      `docker compose` reads `.env` automatically from the project root and
#      substitutes the values below into docker-compose.yml. It also passes
#      them to the `app` container. Nothing else to do.
#
#   2. Plain `npm run start:dev`
#      @nestjs/config loads `.env` from the project root automatically.
#      Note DB_HOST must be `localhost` here, because the app runs on your
#      host machine rather than inside the compose network.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# Port the Nest app binds to. Must match the `ports:` mapping in
# docker-compose.yml (HOST_PORT:CONTAINER_PORT) if you change it.
PORT=3000

# --- PostgreSQL credentials -------------------------------------------------
# These three values must stay in sync with the `environment:` block of the
# `db` service in docker-compose.yml, which uses these same variable names.
# Compose also reads them from this file for the Postgres container's own
# POSTGRES_* variables.
#
# DEV ONLY: `postgres`/`postgres` is a throwaway local password. It is fine
# for a database that is only reachable from your own machine. Do not reuse it
# anywhere else.
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=task

# --- Database host ----------------------------------------------------------
# Under Docker Compose use the *service name* `db`, NOT `localhost`: inside the
# container, `localhost` is the app container itself, so the connection fails.
DB_HOST=db

# Port Postgres listens on inside the container. The app always reaches it at
# `db:5432` over the compose network, so this rarely needs changing.
DB_PORT=5432

# Host-side port for Postgres, used only by external tools (psql, pgAdmin,
# DBeaver) connecting to the container from your machine. Defaults to 5433 in
# docker-compose.yml because a local PostgreSQL install usually owns 5432 and
# the bind then fails with "port is already allocated". Set it to 5432 if that
# port is free on your machine.
DB_HOST_PORT=5433

# --- Schema management ------------------------------------------------------
# `true` lets TypeORM create/alter tables from the entities on boot. Convenient
# locally, but it can destroy data on a real database. Set to `false` and use
# migrations if this ever points at anything you care about.
DB_SYNC=true